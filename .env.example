# Only needed to run the data scripts on your own machine. In GitHub Actions, GitHub Models is used for free automatically.
# Any OpenAI-compatible provider works. For GitHub Models locally, use a GitHub token with the "models" permission.
AI_API_KEY=
AI_BASE_URL=https://models.github.ai/inference
AI_MODEL=openai/gpt-4.1-mini
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
REDDIT_USER_AGENT=interview-prep/0.1 (by u/your_username)
STACKEXCHANGE_KEY=
